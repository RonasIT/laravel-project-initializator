{
  "preset": "laravel",
  "rules": {
    "not_operator_with_successor_space": false,
    "php_unit_set_up_tear_down_visibility": false,
    "php_unit_method_casing": {
      "case": "camel_case"
    },
    "concat_space": {
      "spacing": "one"
    },
    "class_attributes_separation": {
      "elements": {
        "method": "one"
      }
    },
    "array_syntax": {
      "syntax": "short"
    },
    "list_syntax": {
      "syntax": "long"
    },
    "braces": {
      "position_after_functions_and_oop_constructs": "next"
    },
    "single_line_empty_body": false,
    "trailing_comma_in_multiline": {
      "elements": [
        "arguments",
        "arrays",
        "match",
        "parameters"
      ]
    },
    "new_with_parentheses": {
      "anonymous_class": false,
      "named_class": true
    },
    "phpdoc_separation": {
      "skip_unlisted_annotations": false
    },
    "ordered_class_elements": {
      "order": [
        "use_trait",
        "case",
        "constant_public",
        "constant_protected",
        "constant_private",
        "property_public",
        "property_protected",
        "property_private",
        "construct",
        "destruct",
        "magic",
        "phpunit",
        "method_public",
        "method_protected",
        "method_private"
      ],
      "sort_algorithm": "none"
    },
    "void_return": true,
    "explicit_string_variable": true
  }
}